# Screening FastAPI backend
VITE_API_BASE_URL=http://localhost:8000

# Used for audit trail header X-Recruiter-Email
VITE_RECRUITER_EMAIL=recruiter@example.com

# "Sign in with Google" — OAuth 2.0 Client ID (Web application) from
# console.cloud.google.com/apis/credentials, with this app's origin
# (e.g. http://localhost:8080) under "Authorized JavaScript origins".
# Must match the backend's GOOGLE_CLIENT_ID exactly. Leave unset to hide
# the Google button and keep the password form only.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
