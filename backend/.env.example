# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
AZURE_BLOB_CONTAINER_NAME=resumes

# Blob-store performance. The document store is the app's database, so these
# govern most endpoint latency. CONNECTION_POOL must be >= CONCURRENCY or
# batched reads queue for sockets. CACHE_ENABLED serves documents from memory
# while their ETag is unchanged — turn it off only if something other than
# this app writes to the same container.
BLOB_MAX_CONCURRENCY=32
BLOB_CONNECTION_POOL_SIZE=64
BLOB_CACHE_ENABLED=true
BLOB_LISTING_CACHE_SECONDS=5.0

# Copilot latency. GPT-5 reasons before answering and defaults to medium
# effort; the copilot's calls are structured extraction and grounded
# synthesis, where "low" answers far faster. The timeout has to exceed a
# real answer or the request retries and falls back to the deterministic one.
AZURE_OPENAI_REASONING_EFFORT=low
AZURE_OPENAI_TIMEOUT_SECONDS=60

# Azure AI Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-document-intelligence-key
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_ADMIN_KEY=your-search-admin-key
AZURE_SEARCH_INDEX_NAME=candidates-index

# Azure AI Foundry
AZURE_AI_FOUNDRY_PROJECT_ID=your-foundry-project-id

# "Sign in with Google" — OAuth 2.0 Client ID (Web application) from
# console.cloud.google.com/apis/credentials, with the frontend origin under
# "Authorized JavaScript origins". Must match the frontend's
# VITE_GOOGLE_CLIENT_ID exactly — an ID token is only valid for the audience
# it was issued for. Leave unset to keep the Google sign-in endpoint disabled.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# App
API_TITLE=Resume Screening Assistant API
API_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
USE_MOCK_AZURE=true
UPLOAD_DIR=./uploads

# Chat-with-Your-Data accelerator backend
# Default local CWYD compose uses :8000 — run screening API on :8000 and CWYD on :8001
CHATBOT_API_URL=http://localhost:8001
CHATBOT_ENABLED=true
CHATBOT_TIMEOUT_SECONDS=60

# Outbound recruiter emails (candidate approve/reject decisions).
# Gmail: enable 2-Step Verification, then generate an App Password at
# https://myaccount.google.com/apppasswords — use that (not your real password).
# Leave unset to run in mock mode (emails are logged, not actually sent).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=ResumeIQ Recruiting

# External Profile Enrichment Optional Credentials
# GITHUB_TOKEN: Personal access token for authentic GitHub REST API requests
# HACKERRANK_API_KEY: Optional API key for HackerRank verification
GITHUB_TOKEN=
HACKERRANK_API_KEY=

