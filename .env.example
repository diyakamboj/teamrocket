# Copy to .env and fill in. Every value is read server-side only.

# --- Azure AI Document Intelligence (text extraction + OCR for scanned resumes) ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# Optional overrides
# AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
# AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-read

# --- Azure OpenAI (resume parsing, JD analysis, candidate analysis) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
# Deployment name of a chat model (e.g. gpt-4o / gpt-4o-mini)
AZURE_OPENAI_DEPLOYMENT=
# Deployment name of an embedding model (e.g. text-embedding-3-small) — enables semantic matching
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Tuning ---
# Documents processed concurrently through the ingestion pipeline
# RESUME_PIPELINE_CONCURRENCY=4
# RESUME_MAX_FILE_BYTES=20971520
# Candidates that receive the full per-candidate LLM analysis, best-first
# SCREENING_AI_ANALYSIS_LIMIT=50
# SCREENING_CONCURRENCY=4
# Where parsed resumes, jobs and match results are persisted
# RESUMEIQ_DATA_DIR=.data
